# Neonix MONO — sway session (используется в ВМ/без 3D, когда Hyprland не стартует)

set $mod Mod4

output * bg /usr/share/backgrounds/neonix/wallpaper.png fill

# --- оформление: 1px рамки, чёрный фон, без скруглений
default_border pixel 1
default_floating_border pixel 1
gaps inner 4
gaps outer 8
smart_gaps off
hide_edge_borders none
font pango:DejaVu Sans Mono 10

client.focused          #ffffff #000000 #ffffff #ffffff #ffffff
client.focused_inactive #6a6a6a #000000 #6a6a6a #000000 #000000
client.unfocused        #3a3a3a #000000 #3a3a3a #000000 #000000
client.urgent           #ffffff #000000 #ffffff #000000 #000000
client.placeholder      #000000 #000000 #000000 #000000 #000000

xwayland enable

# swaybar не нужен — сверху waybar
bar {
    mode invisible
}

# --- автозапуск
exec waybar -c ~/.config/waybar/config-sway.jsonc
exec mako
# сохранённые обои (своя картинка) поверх стандартных
exec neonix-wallpaper

# --- запуск приложений
bindsym $mod+Return exec foot
bindsym $mod+d exec fuzzel
bindsym $mod+Tab exec fuzzel
bindsym $mod+e exec thunar

# --- обои: выбрать свою картинку / вернуть стандартные
bindsym $mod+Shift+w exec neonix-wallpaper --pick
bindsym $mod+Shift+b exec neonix-wallpaper --default

# --- окна
bindsym $mod+q kill
bindsym $mod+Shift+e exit
bindsym $mod+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+p sticky toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+c reload

# --- фокус
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

# --- перемещение окон
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# --- рабочие столы
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6

# --- мышь
bindsym --whole-window $mod+button3 floating toggle
bindsym $mod+button4 workspace prev
bindsym $mod+button5 workspace next
